PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Required to enable the WorkBuddy remote MCP endpoint. Generate a long random token.
# MCP_AUTH_TOKEN=
# Optional Firebase Admin credentials path; keep the service account file outside source control.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Or use Google Application Default Credentials on a trusted server environment.
FIREBASE_PROJECT_ID=
# Optional: for Render, paste the full service-account JSON as a secret value.
# Never commit a real key or place it in frontend code.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
